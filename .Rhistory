library(FactoMineR)
?catdes
data(wine)
catdes(wine, num.var=2)
data(wine)
res <- catdes(wine, num.var=2)
names(res)
data(wine)
res <- catdes(wine, num.var=2, proba = 0.01)
names(res)
res
data(wine)
res <- catdes(wine, num.var=2, proba = 0.000001)
res
names(res)
res$call
data(wine)
res <- catdes(wine, num.var=2, proba = 0.05)
names(res)
res
data(wine)
res <- catdes(wine, num.var=2, proba = 0.0000000005)
names(res)
names(res)=="call"
data(tea)
catdes(tea, num.var = 20)
catdes(tea, num.var = 2)
catdes(tea, num.var = 1)
res <- catdes(tea, num.var = 1)
names(res)
any(grepl("test.chi2",names(res))) == TRUE
res$test.chi2
res <- catdes(tea, num.var = 1, proba = 0.3)
names(res)
res <- catdes(tea, num.var = 1, proba = 0.8)
names(res)
res <- catdes(tea, num.var = 1, proba = 1)
names(res)
res$quanti
res$quanti.var
names(res)
any(grepl("test.chi2",names(res))) == TRUE
names(self$res)=="call"
names(res)=="call"
sum(names(res)=="call")
sum(names(res)=="call")=1
sum(names(res)=="call")==1
